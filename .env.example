# ─────────────────────────────────────────────────────────────────────────────
# FinPilot configuration. Copy to `.env` (gitignored) and fill in what you use.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM gateway ─────────────────────────────────────────────────────────────
# Mesh API is the default (and hackathon-mandated) gateway: one rsk_ key reaches
# GPT, Claude, Gemini, Llama… via https://api.meshapi.ai/v1
MESH_API_KEY=rsk_your_key_here
LLM_PROVIDER=mesh                      # mesh | openai | groq | gemini | openrouter | anthropic | together | ollama | custom
LLM_MODEL=openai/gpt-4o-mini           # default model for the selected provider (optional)
LLM_ENABLED=true                       # false = fully deterministic mode (zero LLM spend)
LLM_FALLBACK_PROVIDERS=                # e.g. "groq,ollama" — tried in order if the primary fails
LLM_CACHE_ENABLED=true                 # cache deterministic calls in the DB (saves money)

# Per-agent model overrides (optional): cheap model for bulk work, stronger for advice
CATEGORIZER_MODEL=
ADVISOR_MODEL=
CHAT_MODEL=
DIGEST_MODEL=

# Other providers (only needed if you switch to them — all OpenAI-compatible)
OPENAI_API_KEY=
GROQ_API_KEY=                          # free tier: https://console.groq.com
GEMINI_API_KEY=                        # free tier: https://aistudio.google.com
OPENROUTER_API_KEY=                    # ':free' model variants cost nothing
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ── System One decisions (Jev) ──────────────────────────────────────────────
# Closed-set judgments (merchant category, chat routing, faithfulness, goal type,
# CSV columns) go to TypeSafe's Jev via Mesh POST /v1/evaluate — same MESH_API_KEY,
# billed on input tokens only. Without a key every agent uses its deterministic path.
JEV_ENABLED=true
JEV_PROVIDER=mesh                      # mesh (default, POST /v1/evaluate) | typesafe (direct API)
JEV_MODEL=typesafe/jev-1.13            # pin the version: "-latest" aliases can change answers
MESH_API_VERSION=2026-08               # X-Mesh-Version header for /v1/evaluate
TYPESAFE_API_KEY=                      # only for JEV_PROVIDER=typesafe
# Confidence policy — tune with `python -m evaluation.run_eval --jev`
JEV_ACCEPT_CONFIDENCE=0.5              # act on a decision at/above this; below → rules answer stands
JEV_ROUTE_CONFIDENCE=0.6               # chat answered from tools (no LLM) at/above this
JEV_GUARD_CONFIDENCE=0.6               # min P(supported) before LLM-written text is shown
JEV_ORDER_CHECK=true                   # re-ask mid-confidence answers with options reversed
CATEGORIZER_ESCALATE_TO_LLM=false      # cascade unsure categories to the LLM (validate first)
CHAT_FAST_MODEL=                       # cheaper LLM for escalated questions Jev scores as simple
# Prices for cost reporting only (USD per 1M tokens)
JEV_PRICE_IN_PER_1M=0.042
LLM_PRICE_IN_PER_1M=0.15
LLM_PRICE_OUT_PER_1M=0.60

# ── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./finpilot.db   # or postgresql+psycopg://user:pass@host:5432/finpilot
SEED_DEMO_DATA=true                    # load the demo account on first boot
CURRENCY=INR
TIMEZONE=Asia/Kolkata
API_TOKEN=                             # set to require "Authorization: Bearer <token>" on /api
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

# ── Forecasting ─────────────────────────────────────────────────────────────
FORECAST_HORIZON_DAYS=180
MONTE_CARLO_PATHS=400
SAFETY_BUFFER=                         # blank = auto (½ month of fixed + essential costs)

# ── Proactive digests (APScheduler) ─────────────────────────────────────────
SCHEDULER_ENABLED=true                 # run exactly one scheduler per deployment
DIGEST_CRON=0 9 * * mon                # weekly digest (use day names, not numbers)
PIPELINE_CRON=30 2 * * *               # nightly re-analysis

# Email via any SMTP server (e.g. Gmail with an app password — free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=

# Telegram bot (free — create one with @BotFather, then message it once)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
