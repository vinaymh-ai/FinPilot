# ─────────────────────────────────────────────────────────────────────────────
# FinPilot configuration. Copy to `.env` (gitignored) and fill in what you use.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM gateway ─────────────────────────────────────────────────────────────
# Mesh API is the default (and hackathon-mandated) gateway: one rsk_ key reaches
# GPT, Claude, Gemini, Llama… via https://api.meshapi.ai/v1
MESH_API_KEY=rsk_your_key_here
LLM_PROVIDER=mesh                      # mesh | openai | groq | gemini | openrouter | anthropic | together | ollama | freellmapi | custom
LLM_MODEL=openai/gpt-4o-mini           # default model for the selected provider (optional)
LLM_ENABLED=true                       # false = fully deterministic mode (zero LLM spend)
LLM_FALLBACK_PROVIDERS=                # e.g. "groq,ollama" — tried in order if the primary fails
LLM_CACHE_ENABLED=true                 # cache deterministic calls in the DB (saves money)

# Per-agent model overrides (optional): cheap model for bulk work, stronger for advice
CATEGORIZER_MODEL=
ADVISOR_MODEL=
CHAT_MODEL=
DIGEST_MODEL=

# Other providers (only needed if you switch to them — all OpenAI-compatible)
OPENAI_API_KEY=
GROQ_API_KEY=                          # free tier: https://console.groq.com
GEMINI_API_KEY=                        # free tier: https://aistudio.google.com
OPENROUTER_API_KEY=                    # ':free' model variants cost nothing
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# FreeLLMAPI (self-hosted, OpenAI-compatible; one unified key across free providers).
# Run it locally (default http://localhost:3001/v1), then LLM_PROVIDER=freellmapi.
# Docker Compose uses host.docker.internal instead of localhost automatically.
# Override DOCKER_FREELLMAPI_BASE_URL for a remote gateway or another container's service URL.
# Models: auto (default) · auto:fast · auto:smart. It serves chat only — Jev still needs MESH_API_KEY.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
DOCKER_FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
# Any other OpenAI-compatible server (LLM_PROVIDER=custom)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=                      # e.g. auto — the model id that server expects

# ── System One decisions (Jev) ──────────────────────────────────────────────
# Closed-set judgments (merchant category, chat routing, faithfulness, goal type,
# CSV columns) go to TypeSafe's Jev via Mesh POST /v1/evaluate — same MESH_API_KEY,
# billed on input tokens only. Without a key every agent uses its deterministic path.
JEV_ENABLED=true
JEV_PROVIDER=mesh                      # mesh (default, POST /v1/evaluate) | typesafe (direct API)
JEV_MODEL=typesafe/jev-1.13            # pin the version: "-latest" aliases can change answers
MESH_API_VERSION=2026-08               # X-Mesh-Version header for /v1/evaluate
TYPESAFE_API_KEY=                      # only for JEV_PROVIDER=typesafe
# The direct TypeSafe release id is jev-1.13.0 (Mesh's typesafe/jev-1.13 alias is translated).
# Confidence policy — tune with `python -m evaluation.run_eval --jev`
JEV_ACCEPT_CONFIDENCE=0.5              # act on a decision at/above this; below → rules answer stands
JEV_ROUTE_CONFIDENCE=0.6               # chat answered from tools (no LLM) at/above this
JEV_GUARD_CONFIDENCE=0.6               # min P(supported) before LLM-written text is shown
JEV_ORDER_CHECK=true                   # re-ask mid-confidence answers with options reversed
CATEGORIZER_ESCALATE_TO_LLM=false      # cascade unsure categories to the LLM (validate first)
CHAT_FAST_MODEL=                       # cheaper LLM for escalated questions Jev scores as simple
# Prices for cost reporting only (USD per 1M tokens)
JEV_PRICE_IN_PER_1M=0.042
LLM_PRICE_IN_PER_1M=0.15
LLM_PRICE_OUT_PER_1M=0.60

# ── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./finpilot.db   # or postgresql+psycopg://user:pass@host:5432/finpilot
# Compose always connects the app to its PostgreSQL service; DATABASE_URL is for non-Docker runs.
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot             # local development; use a URL-safe password
POSTGRES_DB=finpilot
POSTGRES_PORT=55432
SEED_DEMO_DATA=true                    # seed a new DB once; the first signup inherits the data
CURRENCY=INR
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173

# ── Accounts ────────────────────────────────────────────────────────────────
# Each person signs in with e-mail + password and sees only their own data.
# The first account becomes the admin (server-wide model settings, logs) and takes
# over any data from single-user mode. "Try the demo" gives visitors a private,
# pre-filled sandbox that is deleted after DEMO_TTL_HOURS.
AUTH_ENABLED=true                      # false = single-user mode (no login; everything is user 1)
ALLOW_SIGNUP=true
ADMIN_EMAILS=                          # comma-separated; empty = the first account is admin
DEMO_ACCOUNTS=true
DEMO_TTL_HOURS=48
SESSION_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8
COOKIE_SECURE=                         # empty = Secure cookies when served over HTTPS
PUBLIC_BASE_URL=                       # for password-reset links (default: the request's origin)
API_TOKEN=                             # single-user mode only: require "Authorization: Bearer <token>"

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO                         # DEBUG also logs raw model payloads
LOG_JSON=false                         # console format; the log file is always JSON lines
LOG_FILE=logs/finpilot.log             # rotating; searchable on the Observability page ("" = off)
LOG_FILE_MAX_MB=20
LOG_FILE_BACKUPS=5
TRACE_PAYLOADS=true                    # keep each model call's raw request/response (local DB)
TRACE_MAX_CHARS=20000                  # per string field
TRACE_RETENTION_DAYS=14                # payloads older than this are purged nightly
# LangSmith (optional, off by default — traces contain financial data and leave your machine)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot
LANGSMITH_ENDPOINT=                    # e.g. https://eu.api.smith.langchain.com

# ── Forecasting ─────────────────────────────────────────────────────────────
FORECAST_HORIZON_DAYS=180
MONTE_CARLO_PATHS=400
SAFETY_BUFFER=                         # blank = auto (½ month of fixed + essential costs)

# ── Proactive digests (APScheduler) ─────────────────────────────────────────
SCHEDULER_ENABLED=true                 # run exactly one scheduler per deployment
DIGEST_CRON=0 9 * * mon                # weekly digest (use day names, not numbers)
PIPELINE_CRON=30 2 * * *               # nightly re-analysis

# Email via any SMTP server (e.g. Gmail with an app password — free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=

# Telegram bot (free — create one with @BotFather, then message it once)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
